# PostgreSQL Warehouse Credentials
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=supplyguard_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# FastAPI JWT Security
JWT_SECRET_KEY=supplyguard_production_secure_jwt_secret_key_2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Apache Superset 3.0
SUPERSET_SECRET_KEY=supplyguard_super_secure_enterprise_secret_key_2026
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_URL=http://localhost:8088

# Apache Airflow 2.9
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin

# Data Storage
DATA_DIR=data
